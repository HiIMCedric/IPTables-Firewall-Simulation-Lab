*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Interfaces on the router:
#   eth1 = LAN (10.1.1.0/24)
#   eth2 = DMZ (192.168.10.0/24)
#   eth3 = WAN (172.16.1.0/24)

# =======================================================
# IMPLEMENTED IPTABLES RULES
# =======================================================

# --- 1. ALLOW ESTABLISHED & RELATED TRAFFIC ---
-A INPUT   -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# --- 2. BLACKLIST / THREAT MITIGATION ---
# Drop every new packet from the malicious host, any destination, any port
-A INPUT   -s 172.16.1.200 -j DROP
-A FORWARD -s 172.16.1.200 -j DROP

# --- 3. LAN TO DMZ & WAN ACCESS ---
-A FORWARD -i eth1 -o eth2 -j ACCEPT
-A FORWARD -i eth1 -o eth3 -j ACCEPT

# --- 4. WAN TO DMZ ACCESS ---
# Only HTTP/HTTPS to the DMZ web server; everything else hits the default DROP
-A FORWARD -i eth3 -o eth2 -d 192.168.10.10 -p tcp -m multiport --dports 80,443 -j ACCEPT

COMMIT
